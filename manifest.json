{
  "manifest_version": 3,
  "name": "Chrome Tab Manager",
  "version": "1.0.1",
  "description": "Ücretsiz ve güçlü sekme yönetim eklentisi",
  "permissions": [
    "tabs",
    "storage",
    "tabGroups",
    "bookmarks",
    "favicon"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
